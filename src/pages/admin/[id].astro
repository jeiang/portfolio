---
import Admin from "../../layouts/Admin.astro";
import { getConfig } from "../../lib/config.ts";
import { toDatetimeLocal } from "../../lib/format.ts";
import { getById } from "../../lib/posts.ts";

const { blogUrl } = getConfig();
const id = Number(Astro.params.id);
const post = Number.isInteger(id) ? getById(id) : undefined;

if (!post) return Astro.redirect("/admin", 303);

// Inlined into <script type="application/json">, so `<` must be escaped: a body
// containing `</script>` (or `<!--<script`) would otherwise end the block early,
// breaking JSON.parse and the whole editor, and inject the rest as markup.
const postData = JSON.stringify({
  id: post.id,
  body_md: post.body_md,
  cover_image: post.cover_image,
  status: post.status,
})
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<Admin title={`Edit · ${post.title}`}>
  <main class="admin">
    <div class="admin-bar">
      <h1>Edit post</h1>
      <div class="admin-actions">
        <span class="status-line" id="status-line"></span>
        <button type="button" id="toggle-source">Markdown</button>
        <button type="button" class="button-danger" id="delete">Delete</button>
        <button type="button" class="button" id="toggle-publish">
          {post.status === "published" ? "Unpublish" : "Publish"}
        </button>
        <button type="button" class="button-primary" id="save">Save</button>
        <a class="button" href="/admin">Back</a>
      </div>
    </div>

    <label class="field">
      <span>Title</span>
      <input type="text" id="title" value={post.title} />
    </label>

    <div class="field-row">
      <label class="field">
        <span>Slug</span>
        <input type="text" id="slug" value={post.slug} />
        <span class="hint" id="published-hint" hidden={post.status !== "published"}>
          Published at {blogUrl}/<span id="published-slug">{post.slug}</span> — changing
          this breaks every existing link to it.
        </span>
      </label>

      <label class="field">
        <span>Status</span>
        <select id="status">
          <option value="draft" selected={post.status === "draft"}>Draft</option>
          <option value="published" selected={post.status === "published"}
            >Published</option
          >
        </select>
      </label>

      <label class="field">
        <span>Publish date (UTC)</span>
        <input
          type="datetime-local"
          id="published-at"
          value={toDatetimeLocal(post.published_at)}
        />
        <span class="hint">A future date schedules the post.</span>
      </label>
    </div>

    <label class="field">
      <span>Excerpt</span>
      <textarea id="excerpt" rows="2">{post.excerpt ?? ""}</textarea>
      <span class="hint">Optional. Falls back to the first 160 characters.</span>
    </label>

    <div class="field">
      <span>Cover image</span>
      <div class="admin-actions">
        <input type="file" id="cover-file" accept="image/*" hidden />
        <button type="button" id="cover-pick">Choose image</button>
        <button type="button" class="button" id="cover-clear" hidden={!post.cover_image}
          >Remove</button
        >
      </div>
      <img
        class="cover-preview"
        id="cover-preview"
        src={post.cover_image ? `/uploads/${post.cover_image}` : ""}
        alt=""
        hidden={!post.cover_image}
      />
    </div>

    <div class="editor-shell" id="editor-shell" data-mode="wysiwyg">
      <div id="editor-wysiwyg"></div>
      <textarea id="editor-source" spellcheck="false"></textarea>
    </div>

    <script
      is:inline
      type="application/json"
      id="post-data"
      set:html={postData}
    />

    <script>
      import "../../scripts/editor.ts";
    </script>
  </main>
</Admin>
