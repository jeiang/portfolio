---
import Admin from "../../layouts/Admin.astro";
import { getConfig } from "../../lib/config.ts";
import { now } from "../../lib/db.ts";
import { formatDate } from "../../lib/format.ts";
import { listAll } from "../../lib/posts.ts";

const { blogUrl } = getConfig();
const posts = listAll();
const at = now();

// A published post with a future date is not public yet, so it has nothing
// to View (the blog 404s it) and must not read as live.
const stateOf = (post: (typeof posts)[number]) =>
  post.status === "draft"
    ? "draft"
    : post.published_at !== null && post.published_at > at
      ? "scheduled"
      : "published";
const LABELS = { draft: "Draft", published: "Published", scheduled: "Scheduled" };
---

<Admin title="Posts">
  <main class="admin">
    <div class="admin-bar">
      <h1>Posts</h1>
      <div class="admin-actions">
        <form method="post" action="/api/posts">
          <button class="button-primary" type="submit">New post</button>
        </form>
        <form method="post" action="/api/logout">
          <button type="submit">Sign out</button>
        </form>
      </div>
    </div>

    {
      posts.length === 0 ? (
        <p class="hint">No posts yet.</p>
      ) : (
        <div class="admin-list">
          {posts.map((post) => {
            const state = stateOf(post);
            return (
              <div class="admin-row">
                <div class="admin-row-title">
                  <a href={`/admin/${post.id}`}>{post.title}</a>
                  <div class="admin-row-meta">
                    /{post.slug} · {formatDate(post.published_at ?? post.updated_at)}
                  </div>
                </div>
                <span class={`badge badge-${state}`}>{LABELS[state]}</span>
                <div class="admin-row-actions">
                  {state === "published" ? (
                    <a
                      class="button"
                      href={`${blogUrl}/${post.slug}`}
                      target="_blank"
                      rel="noopener"
                    >
                      View
                    </a>
                  ) : (
                    <span class="admin-row-action-slot" />
                  )}
                  <a class="button" href={`/admin/${post.id}`}>
                    Edit
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </main>
</Admin>
